# Copy to deploy/.env and fill in. Never commit .env (it is git-ignored).
# Generate secrets on the server as described in docs/SERVER_SETUP.md.

# --- Domains -------------------------------------------------------------------
# Web app and API on two subdomains of the same domain (see Caddyfile).
APP_DOMAIN=app.sowling.com
API_DOMAIN=api.sowling.com
# For Let's Encrypt notices (certificate problems).
ACME_EMAIL=info@blocksocial.eu
TZ=Europe/Berlin

# --- Database ------------------------------------------------------------------
# Long random password: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Backend secrets -----------------------------------------------------------
# openssl rand -hex 48
JWT_SECRET=
# docker compose run --rm backend gen-license-keys   (keep forever, see docs/LIZENZEN.md)
LICENSE_SIGNING_KEY=
# docker compose run --rm backend gen-vapid-keys     (keep forever; empty = push off)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@blocksocial.eu

# --- Stripe --------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
# "Gärtnerei" plan (unlimited plants).
STRIPE_PRICE_NURSERY=
# One-time payment for the desktop app.
STRIPE_PRICE_DESKTOP=

# --- E-mail (Hostinger Mail) ---------------------------------------------------
# License keys after a purchase and `license create --send` / `voucher create
# --email`. Empty SMTP_HOST = no e-mail. Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=service@sowling.com
SMTP_PASSWORD=
MAIL_FROM=Sowling <service@sowling.com>

# --- Desktop app ---------------------------------------------------------------
# Link to the Windows installer (may be public; the app needs a license).
DESKTOP_DOWNLOAD_URL=

# --- Backups -------------------------------------------------------------------
# PUBLIC age key (age1...). The private key stays offline, see docs/SERVER_SETUP.md.
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=3

# --- Optional (defaults shown) -------------------------------------------------
# RETENTION_WEATHER_DAYS=365
# RETENTION_TOMBSTONE_DAYS=180
# RETENTION_TOKEN_GRACE_DAYS=7
# RETENTION_HISTORY_PER_USER=200
# PUSH_INTERVAL_SECONDS=300
