{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sowling",
  "version": "0.1.0",
  "identifier": "eu.blocksocial.plantscalendar",
  "build": {
    "beforeDevCommand": "npm run dev -- --host",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sowling",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; connect-src 'self' http://localhost:* http://127.0.0.1:* https://api.stripe.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/photos/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
